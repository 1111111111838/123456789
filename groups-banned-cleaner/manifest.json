{
  "manifest_version": 3,
  "name": "Chat Banned Cleaner – ניקוי חסומים ממרחבי צ'אט",
  "version": "3.1.0",
  "description": "שואב חסומים מ-Google Groups ומסיר אותם ממרחבי Google Chat שבהם אתה מנהל. בלי מפתחות ובלי API.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "identity.email"
  ],
  "host_permissions": [
    "https://groups.google.com/*",
    "https://mail.google.com/*",
    "https://chat.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ניקוי חסומים ממרחבי צ'אט"
  }
}